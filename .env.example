# DeepSeek API 配置
DEEPSEEK_API_KEY=api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# 智谱 AI Embedding 配置（本地模型不可用时的兜底方案）
ZHIPU_API_KEY=
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# Embedding 本地/API 策略
# 模式: local_first（本地BGE-M3优先，失败降级API）/ local（仅本地） / api（仅API）
EMBEDDING_MODE=local_first
# 本地 BGE-M3 模型路径（Windows: E:/huggingface/model，Docker: /models/bge-m3）
LOCAL_EMBEDDING_MODEL_PATH=./models/bge-m3
# API 模式下使用的智谱模型名
EMBEDDING_MODEL=embedding-2
EMBEDDING_DIMENSIONS=1024

# 数据库配置
# MySQL（推荐）
DATABASE_URL=mysql+pymysql://root:heritagemind@localhost:3306/heritagemind
# SQLite（本地单机开发）
# DATABASE_URL=sqlite:///./data/heritage.db
# PostgreSQL（生产环境）
# DATABASE_URL=postgresql://heritagemind:heritagemind@localhost:5432/heritagemind

# JWT 认证密钥（生产环境必须修改为强随机字符串）
JWT_SECRET_KEY=change-me-in-production

# Langfuse 可观测性（可选，不填则不启用追踪）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_ENABLED=false

# 日志级别
LOG_LEVEL=INFO

# ============ 音频转写与检索（v1.4） ============
# 上传 media_type=audio 是否自动入队转写
AUDIO_TRANSCRIBE_ENABLED=true
# lifespan 是否启动转写 worker（需 Redis 可达才真正消费）
AUDIO_WORKER_ENABLED=true
# faster-whisper CTranslate2 模型目录（本地加载，无需联网）
WHISPER_MODEL_DIR=E:/huggingface/faster-whisper-small
WHISPER_DEVICE=cpu
# CPU 量化：int8 / int8_float32 / float32
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4
WHISPER_LANGUAGE=zh
WHISPER_BEAM_SIZE=5
AUDIO_CHUNK_MAX_CHARS=500
AUDIO_CHUNK_OVERLAP=50
AUDIO_INDEX_COLLECTION=audio_transcripts
AUDIO_INDEX_PATH=./data/audio_chroma
AUDIO_MAX_ATTEMPTS=3
AUDIO_STALE_MINUTES=15

# ============ Redis（v1.4：问答缓存 + 转写任务队列） ============
REDIS_URL=redis://localhost:6379
# 问答缓存后端：auto（Redis 可达用 Redis，否则进程内 LRU）/ redis / memory
CACHE_BACKEND=auto
REDIS_CACHE_PREFIX=qa:v1
AUDIO_QUEUE_KEY=heritagemind:audio:transcribe
