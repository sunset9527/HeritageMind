# DeepSeek API 配置
DEEPSEEK_API_KEY=api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# 智谱 AI Embedding 配置
ZHIPU_API_KEY=
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# 数据库配置
# MySQL（推荐）
DATABASE_URL=mysql+pymysql://root:heritagemind@localhost:3306/heritagemind
# SQLite（本地单机开发）
# DATABASE_URL=sqlite:///./data/heritage.db
# PostgreSQL（生产环境）
# DATABASE_URL=postgresql://heritagemind:heritagemind@localhost:5432/heritagemind

# JWT 认证密钥（生产环境必须修改为强随机字符串）
JWT_SECRET_KEY=change-me-in-production

# Langfuse 可观测性（可选，不填则不启用追踪）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_ENABLED=false

# 日志级别
LOG_LEVEL=INFO
